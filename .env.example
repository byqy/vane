# 复制为 .env 后按需修改；不要提交 .env

# 对外访问端口（Nginx）
HTTP_PORT=8080

# 数据库
DB_NAME=vane
DB_USERNAME=vane
DB_PASSWORD=change-me-strong-password
# 仅本机排障用，生产建议不暴露
DB_PORT=127.0.0.1:55432

# MFA 主密钥：base64 编码的 32 字节随机值
# 生成：openssl rand -base64 32
MFA_SECRET_KEY=

# 会话 Cookie 是否需要 Secure（HTTPS 部署设为 true）
AUTH_COOKIE_SECURE=false

# 邮件（留空则降级为日志，不真实发送）
SPRING_MAIL_HOST=
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
VANE_MAIL_FROM=no-reply@vane.local
